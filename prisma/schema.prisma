// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Luminaria {
  id        Int      @id @default(autoincrement())
  codigo    String?  @unique
  direccion String?
  sector    String
  potencia  Int
  estado    String   @default("encendida")
  creadaEn  DateTime @default(now())

  @@index([sector])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  rol          String   @default("operador")
  creadoEn     DateTime @default(now())
}

// Trabajos que se procesan en segundo plano a través de SQS.
// SQS no guarda resultados, por eso el estado y el resultado viven aquí.
model Trabajo {
  id            String   @id @default(uuid())
  tipo          String
  estado        String   @default("pendiente") // pendiente | procesando | completado | fallido
  resultado     Json?
  error         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}